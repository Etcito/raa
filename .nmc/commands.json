[
  {"name": "raa-js-cargo-test", "command": "cargo test -p raa-js --quiet", "timeout_s": 1500},
  {"name": "raa-load-once-unit", "command": "node --test packages/raa/test/load-once.test.mjs", "timeout_s": 60},
  {"name": "raa-sdfm-node-test", "command": "node --test \"packages/raa-sdfm/test/*.test.js\" \"packages/raa-sdfm/test/*.test.mjs\"", "timeout_s": 900, "after": ["raa-js-cargo-test"]},
  {"name": "raa-bricks", "command": "bash scripts/build-bricks.sh --out dist/bricks", "timeout_s": 1800},
  {"name": "m2-lights-build", "command": "bash scripts/build-lights.sh", "timeout_s": 1800},
  {"name": "m2-lights-functional", "command": "node --test web/common/lights-job.test.mjs", "timeout_s": 120, "after": ["m2-lights-build"]},
  {"name": "m2-lights-select", "command": "node web/common/lights-job.mjs select --page dist/lights --out out/lights", "timeout_s": 120, "after": ["m2-lights-build"]},
  {"name": "m2-lights-clean", "command": "node web/common/lights-job.mjs clean --page dist/lights --out out/lights", "timeout_s": 60, "after": ["m2-lights-select"]},
  {"name": "m2-lights-render", "command": "node web/common/lights-job.mjs render --page dist/lights --out out/lights", "timeout_s": 3600, "after": ["m2-lights-clean"]},
  {"name": "m2-lights-fresh", "command": "node web/common/lights-job.mjs fresh --page dist/lights --out out/lights", "timeout_s": 120, "after": ["m2-lights-render"]},
  {"name": "m2-lights-judge", "command": "node web/common/lights-job.mjs judge --page dist/lights --out out/lights", "timeout_s": 3600, "after": ["m2-lights-render", "m2-lights-fresh"]},
  {"name": "m2-lights-command-check", "command": "nmc-commands-check", "timeout_s": 60, "after": ["m2-lights-functional", "m2-lights-judge"]}
]
