[
  {
    "name": "check-m16-cargo",
    "command": "cargo check",
    "timeout_s": 900,
    "cwd": "."
  },
  {
    "name": "verify-m16-anim",
    "command": "node proofs/m16-anim-brick.mjs",
    "timeout_s": 3600,
    "cwd": ".",
    "after": [
      "check-m16-cargo"
    ]
  },
  {
    "name": "check-m16-scripts",
    "command": "env GALLIUM_DRIVER=llvmpipe bash scripts/check.sh",
    "timeout_s": 3600,
    "cwd": ".",
    "after": [
      "verify-m16-anim"
    ]
  }
]
