[
  {
    "name": "scene-check",
    "command": "node --test --test-concurrency=1 'examples/lookdev/test/m14-*.test.mjs'",
    "timeout_s": 60,
    "cwd": "."
  },
  {
    "name": "build-lookdev",
    "command": "bash scripts/build-lookdev.sh",
    "timeout_s": 1200,
    "cwd": ".",
    "after": [
      "scene-check"
    ]
  },
  {
    "name": "judge-neon",
    "command": "env NMC_CPUS=1 node scripts/lookdev-capture.mjs --only 'm14-camera-effects--world-neon$' --judge --ref-prefix /refs/",
    "timeout_s": 480,
    "cwd": ".",
    "after": [
      "build-lookdev"
    ]
  },
  {
    "name": "neon-image-check",
    "command": "python3 scripts/check-neon-capture.py",
    "timeout_s": 60,
    "cwd": ".",
    "after": [
      "judge-neon"
    ]
  },
  {
    "name": "proof-m14",
    "command": "node proofs/m14-camera-effects.mjs",
    "timeout_s": 1200,
    "cwd": ".",
    "after": [
      "neon-image-check"
    ]
  },
  {
    "name": "cargo-check",
    "command": "cargo check",
    "timeout_s": 480,
    "cwd": ".",
    "after": [
      "proof-m14"
    ]
  },
  {
    "name": "p2-smoke",
    "command": "node proofs/lib/p2-smoke.mjs",
    "timeout_s": 60,
    "cwd": ".",
    "after": [
      "cargo-check"
    ]
  }
]
