[
  {"name": "raa-js-cargo-test", "command": "cargo test -p raa-js --quiet", "timeout_s": 1500},
  {"name": "raa-sdfm-node-test", "command": "node --test \"packages/raa-sdfm/test/*.test.js\" \"packages/raa-sdfm/test/*.test.mjs\"", "timeout_s": 900, "after": ["raa-js-cargo-test"]},
  {"name": "raa-bricks", "command": "bash scripts/build-bricks.sh --out dist/bricks", "timeout_s": 1800},
  {"name": "trace-first-pixel-unit", "command": "node --test scripts/trace-first-pixel.test.mjs", "timeout_s": 120},
  {"name": "trace-first-pixel-build", "command": "bash scripts/build-package.sh", "timeout_s": 1800},
  {"name": "trace-first-pixel-stage", "command": "node scripts/trace-first-pixel.mjs stage", "timeout_s": 120, "after": ["trace-first-pixel-build"]},
  {"name": "trace-first-pixel-clean", "command": "node scripts/trace-first-pixel.mjs clean", "timeout_s": 60, "after": ["trace-first-pixel-stage"]},
  {"name": "trace-first-pixel-render", "command": "node scripts/trace-first-pixel.mjs render --out proofs/captures/trace-first-pixel.png", "timeout_s": 900, "after": ["trace-first-pixel-clean"]},
  {"name": "trace-first-pixel-fresh", "command": "node scripts/trace-first-pixel.mjs fresh", "timeout_s": 60, "after": ["trace-first-pixel-render"]},
  {"name": "trace-first-pixel-judge", "command": "python3 \"$NMC_JUDGE_CLIENT\" proofs/captures/trace-first-pixel.png --description \"A GPU sphere-traced render of exactly two flat-shaded solid shapes on a dark background: a reddish cube on the left and a blue sphere on the right, both fully visible with clean silhouettes\"", "timeout_s": 600, "after": ["trace-first-pixel-fresh"]}
]
