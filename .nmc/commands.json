[
  {
    "name": "neon-tests",
    "command": "node --test --test-name-pattern 'owner acceptance' examples/lookdev/test/m14-neon.test.mjs",
    "timeout_s": 60,
    "cwd": "."
  },
  {
    "name": "proof-m14",
    "command": "node proofs/m14-camera-effects.mjs",
    "timeout_s": 1800,
    "cwd": ".",
    "after": [
      "neon-tests"
    ]
  },
  {
    "name": "p2-smoke",
    "command": "node proofs/lib/p2-smoke.mjs",
    "timeout_s": 120,
    "cwd": ".",
    "after": [
      "proof-m14"
    ]
  },
  {
    "name": "cargo-check",
    "command": "cargo check",
    "timeout_s": 1800,
    "cwd": ".",
    "after": [
      "p2-smoke"
    ]
  }
]
