[
  {
    "name": "build-lookdev",
    "command": "bash scripts/build-lookdev.sh",
    "timeout_s": 1800,
    "cwd": "."
  },
  {
    "name": "capture-m15",
    "command": "env NMC_CPUS=4 node scripts/lookdev-capture.mjs --milestone m15 --judge --ref-prefix /refs/",
    "timeout_s": 3000,
    "cwd": ".",
    "after": [
      "build-lookdev"
    ]
  },
  {
    "name": "proof-m15",
    "command": "node proofs/m15-animation.mjs",
    "timeout_s": 1800,
    "cwd": ".",
    "after": [
      "capture-m15"
    ]
  },
  {
    "name": "p2-smoke",
    "command": "node proofs/lib/p2-smoke.mjs",
    "timeout_s": 120,
    "cwd": ".",
    "after": [
      "proof-m15"
    ]
  }
]
