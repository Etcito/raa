[
  {
    "name": "cargo-check",
    "command": "env CARGO_BUILD_JOBS=1 cargo check",
    "timeout_s": 600,
    "cwd": "."
  },
  {
    "name": "build-lookdev",
    "command": "bash scripts/build-lookdev.sh",
    "timeout_s": 1800,
    "cwd": ".",
    "after": [
      "cargo-check"
    ]
  },
  {
    "name": "judge-f00-f06",
    "command": "env NMC_CPUS=2 node scripts/lookdev-capture.mjs --only 'm15-waddle--f0[06]$' --judge --ref-prefix /refs/",
    "timeout_s": 1200,
    "cwd": ".",
    "after": ["build-lookdev"]
  },
  {
    "name": "p2-smoke",
    "command": "node proofs/lib/p2-smoke.mjs",
    "timeout_s": 120,
    "cwd": ".",
    "after": ["judge-f00-f06"]
  }
]
