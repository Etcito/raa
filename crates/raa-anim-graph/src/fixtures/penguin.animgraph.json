  {"from":"locomotion","to":"grab","when":[{"param":"grab","op":"trigger"}],"blendTicks":3,"exitTick":null,"priority":2},
  {"from":"grab","to":"hang","when":[],"blendTicks":3,"exitTick":8,"priority":0},
  {"from":"hang","to":"climbUp","when":[{"param":"climb","op":"trigger"}],"blendTicks":4,"exitTick":null,"priority":0},
  {"from":"climbUp","to":"locomotion","when":[],"blendTicks":6,"exitTick":22,"priority":0},
  {"from":"locomotion","to":"handPush","when":[{"param":"push","op":"==","value":true}],"blendTicks":5,"exitTick":null,"priority":3},
  {"from":"handPush","to":"locomotion","when":[{"param":"push","op":"==","value":false}],"blendTicks":5,"exitTick":null,"priority":0}]},
 {"name":"emote","entry":"emote.wave","states":[
  {"name":"emote.wave","motion":"emote.wave","loop":true,"speedParam":null},
  {"name":"emote.dance","motion":"emote.dance","loop":true,"speedParam":null},
  {"name":"emote.cheer","motion":"emote.cheer","loop":true,"speedParam":null},
  {"name":"emote.laugh","motion":"emote.laugh","loop":true,"speedParam":null}],
 "transitions":[
