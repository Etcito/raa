  {"name":"hang","motion":"hang","loop":true,"speedParam":null},
  {"name":"climbUp","motion":"climbUp","loop":false,"speedParam":null},
  {"name":"handPush","motion":"handPush","loop":true,"speedParam":null}],
 "transitions":[
  {"from":"locomotion","to":"jump","when":[{"param":"jump","op":"trigger"}],"blendTicks":4,"exitTick":null,"priority":0},
  {"from":"jump","to":"fall","when":[],"blendTicks":4,"exitTick":12,"priority":0},
