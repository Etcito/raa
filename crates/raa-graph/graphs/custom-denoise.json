    {
      "id": "giAccumulate",
      "type": "gi.accumulate",
      "params": {
        "historyMax": 128,
        "historyMin": 1,
        "clampGamma": 3,
        "accDepthTolerance": 0.04,
        "accNormalCos": 0.9,
        "accMinWeight": 0.05,
