{
  "format": "raa.render-graph",
  "version": 1,
  "name": "Box blur",
  "nodes": [
    {
      "id": "boxBlur",
      "type": "compute.wgsl",
      "inputs": [
        {
          "key": "src",
          "type": "image2d"
        }
      ],
      "outputs": [
        {
          "key": "dst",
          "type": "image2d",
          "format": "rgba16float"
        }
      ],
      "math": {
        "nodes": [
          {
            "id": "blur",
            "type": "box",
            "params": {
              "input": "src",
              "radius": 2
            },
            "position": [
              0,
              0
            ]
          },
          {
            "id": "out",
            "type": "output",
            "params": {
              "key": "dst"
            },
            "position": [
              240,
              0
            ]
          }
        ],
        "links": [
          {
            "from": {
              "node": "blur",
              "port": "value"
            },
            "to": {
              "node": "out",
              "port": "value"
            }
          }
        ]
      },
      "wgsl": "fn rg_main(p: vec2<u32>) {\n  let q = vec2<i32>(p);\n  var n0_acc = vec4<f32>(0.0);\n  for (var n0_y = -2; n0_y <= 2; n0_y++) {\n    for (var n0_x = -2; n0_x <= 2; n0_x++) {\n      n0_acc += textureLoad(rg_in_src, clamp(q + vec2<i32>(n0_x, n0_y), vec2<i32>(0), vec2<i32>(textureDimensions(rg_in_src)) - vec2<i32>(1)), 0);\n    }\n  }\n  let n0_value = n0_acc / 25.0;\n  textureStore(rg_out_dst, p, n0_value);\n}\n"
    }
  ],
  "links": []
}
